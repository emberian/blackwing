    "narrative",
    "deck-builder"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21",
    "vitest": "^1.0.0"
  }
}
