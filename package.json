{
  "name": "cargo-hold",
  "version": "0.1.0",
  "description": "A mobile-first narrative idle trading game with deck-building mechanics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:core": "tsc",
    "preview": "vite preview",
    "test": "vitest",
