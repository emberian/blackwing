{
  "name": "holdsmith-vscode",
  "displayName": "Holdsmith Scene Language",
  "description": "Language support for Holdsmith .scene files",
  "version": "0.1.0",
  "publisher": "blackwing",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:scene"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "scene",
        "aliases": [
          "Holdsmith Scene",
          "scene"
        ],
        "extensions": [
          ".scene"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scene",
        "scopeName": "source.scene",
        "path": "./syntaxes/scene.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Holdsmith",
      "properties": {
        "holdsmith.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the holdsmith-lsp executable. If empty, uses 'holdsmith-lsp' from PATH."
        },
        "holdsmith.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
