{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holdsmith",
  "identifier": "com.blackwing.holdsmith",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "cd crates/holdsmith-app && trunk serve --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd crates/holdsmith-app && trunk build --release",
    "frontendDist": "../holdsmith-app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Holdsmith IDE",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [],
    "category": "DeveloperTool",
    "shortDescription": "Interactive Fiction IDE",
    "longDescription": "Holdsmith is an IDE for authoring, analyzing, debugging, and playing interactive fiction games built with the Blackwing engine.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
