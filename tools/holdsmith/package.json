{
  "name": "holdsmith",
  "version": "0.1.0",
  "description": "Scene DSL toolkit for Blackwing and narrative games",
  "type": "module",
  "bin": {
    "holdsmith": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:cli": "tsc",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dsl",
    "narrative",
    "game",
    "authoring",
    "interactive-fiction"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "yaml": "^2.3.0"
  }
}
